
{
  "manifest_version": 3,
  "name": "NEXCORE OPERATOR",
  "version": "1.0.3",
  "description": "Assistant intelligent de navigation et d'automatisation pour Firefox Android.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [],
  "action": {
    "default_title": "NEXCORE OPERATOR",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nexcore-operator@example.org",
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
